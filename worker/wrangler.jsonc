{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manga-downloader-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Requests carry IPs: no request logs, ever.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "UPDATE_STATE", "class_name": "UpdateState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpdateState"] }],
  "analytics_engine_datasets": [{ "binding": "UPDATE_CHECKS", "dataset": "manga_downloader_checks" }]
}
