+func shotInt(k string, d int) int {
+	if v, err := strconv.Atoi(os.Getenv(k)); err == nil {
+		return v
+	}
+	return d
+}
+
+func shotBg() *options.RGBA {
+	switch os.Getenv("SHOT_THEME") {
+	case "dark":
+		return &darkBackground
+	case "light":
+		return &lightBackground
+	}
+	return startupBackground()
+}
+
+func shotMac() *mac.Options {
+	switch os.Getenv("SHOT_THEME") {
+	case "dark":
+		return &mac.Options{Appearance: mac.NSAppearanceNameDarkAqua}
+	case "light":
+		return &mac.Options{Appearance: mac.NSAppearanceNameAqua}
+	}
